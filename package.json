{
  "name": "sanding-monitoring-web-app",
  "version": "1.5.2",
  "description": "A basic React app with minimal dependencies",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && npx serve -s dist",
    "build": "vite build",
    "preview": "vite preview",
    "sanity": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@viamrobotics/motion-tools": "1.2.2",
    "@viamrobotics/svelte-sdk": "^1.0.1",
    "@viamrobotics/prime-core": "0.1.5",
    "@tanstack/svelte-query": "^5.69.0",
    "@viamrobotics/sdk": "^0.57.0",
    "js-cookie": "^3.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@tailwindcss/vite": "4.1.13",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.1.13",
    "@eslint/js": "^9.39.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "svelte": "^5.46.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0"
  }
}
